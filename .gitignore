
# Rust build output (target-verify is the isolated CARGO_TARGET_DIR used by
# verification runs while live MCP processes hold target/debug binaries)
/target/
/target-verify/

# Local Engram state. Exports intended for sharing must be written elsewhere.
/.engram/

# Local tooling and editor state
.DS_Store
.idea/
.vscode/
*.diff

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Codex split worktrees live inside the checkout under .worktrees/
.worktrees/
# Claude subagent worktrees live inside the checkout under .claude/worktrees/
.claude/worktrees/
